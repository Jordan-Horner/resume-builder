# Absolute host paths. Copy this file to .env; .env is ignored by Git.
RESUME_BUILDER_WORKSPACE_PATH=/absolute/path/to/private-workspace
RESUME_BUILDER_RUNTIME_PATH=/absolute/path/to/private-runtime
RESUME_BUILDER_TIMEZONE=America/New_York
RESUME_BUILDER_LOG_LEVEL=INFO
# Use text for readable container logs or json for an external log collector.
RESUME_BUILDER_LOG_FORMAT=text
# Optional: fast-forward only the mounted Git workspace, never application code.
RESUME_BUILDER_WORKSPACE_SYNC_ENABLED=false
RESUME_BUILDER_WORKSPACE_SYNC_INTERVAL_SECONDS=300
# For a private SSH remote, mount both files under the runtime path and set these.
RESUME_BUILDER_WORKSPACE_SYNC_SSH_KEY_FILE=
RESUME_BUILDER_WORKSPACE_SYNC_KNOWN_HOSTS_FILE=
# Optional HTTPS alternative; the existing private-update token is reused when present.
RESUME_BUILDER_WORKSPACE_SYNC_TOKEN_FILE=
# Use a unique immutable value (for example, a Git commit) for remote deployments.
RESUME_BUILDER_IMAGE_TAG=local
# Optional container-only override. The search config's safety ceiling still applies.
JOB_PULLER_LINKEDIN_RESULTS_WANTED=

# Optional. Required only for `resume-builder agent ask`.
OPENROUTER_API_KEY=

# Optional. Required only for the private Telegram agent service.
RESUME_BUILDER_TELEGRAM_BOT_TOKEN=

# Optional. Required only when notifications.sink is discord.
RESUME_BUILDER_DISCORD_WEBHOOK=
